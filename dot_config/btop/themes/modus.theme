# Modus vivendi (deuteranopia) theme for btop.
# Palette: miikanissi/modus-themes.nvim, background lowered to #121212.
# Gauges ramp by LIGHTNESS (dark -> bright) so magnitude reads without hue.
theme[main_bg]="#121212"
theme[main_fg]="#ffffff"
theme[title]="#ffffff"
theme[hi_fg]="#efef00"
theme[selected_bg]="#3a3a4a"
theme[selected_fg]="#ffffff"
theme[inactive_fg]="#7a7a7a"
theme[graph_text]="#989898"
theme[meter_bg]="#242424"
theme[proc_misc]="#c4d5ff"
theme[cpu_box]="#646464"
theme[mem_box]="#646464"
theme[net_box]="#646464"
theme[proc_box]="#646464"
theme[div_line]="#646464"
theme[temp_start]="#79a8ff"
theme[temp_mid]="#ffa00f"
theme[temp_end]="#ff5f59"
theme[cpu_start]="#00d3d0"
theme[cpu_mid]="#efef00"
theme[cpu_end]="#ff5f59"
theme[free_start]="#79a8ff"
theme[free_mid]="#c4d5ff"
theme[free_end]="#ffffff"
theme[cached_start]="#00d3d0"
theme[cached_mid]="#c4d5ff"
theme[cached_end]="#ffffff"
theme[available_start]="#79a8ff"
theme[available_mid]="#c4d5ff"
theme[available_end]="#ffffff"
theme[used_start]="#00d3d0"
theme[used_mid]="#efef00"
theme[used_end]="#ff5f59"
theme[download_start]="#79a8ff"
theme[download_mid]="#c4d5ff"
theme[download_end]="#ffffff"
theme[upload_start]="#ffa00f"
theme[upload_mid]="#efef00"
theme[upload_end]="#ff5f59"
theme[process_start]="#00d3d0"
theme[process_mid]="#efef00"
theme[process_end]="#ff5f59"
