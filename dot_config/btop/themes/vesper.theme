# Vesper theme for btop. Palette: raunofreiberg/vesper.
# Gauges ramp by LIGHTNESS within Vesper's few hues so magnitude reads
# without depending on hue discrimination.
theme[main_bg]="#101010"
theme[main_fg]="#ffffff"
theme[title]="#ffffff"
theme[hi_fg]="#ffc799"
theme[selected_bg]="#343434"
theme[selected_fg]="#ffffff"
theme[inactive_fg]="#707070"
theme[graph_text]="#a0a0a0"
theme[meter_bg]="#232323"
theme[proc_misc]="#66cbb2"
theme[cpu_box]="#505050"
theme[mem_box]="#505050"
theme[net_box]="#505050"
theme[proc_box]="#505050"
theme[div_line]="#505050"
theme[temp_start]="#74828d"
theme[temp_mid]="#ffc799"
theme[temp_end]="#ff8080"
theme[cpu_start]="#66cbb2"
